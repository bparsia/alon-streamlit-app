// Lark grammar for restricted Mermaid class diagrams
// Supports: YAML front matter, associations (-->), and moment
// proposition declarations

?start: frontmatter? diagram

// Optional YAML front matter (between --- delimiters)
// Capture YAML as a single block to preserve indentation
frontmatter: "---" _NL YAML_BLOCK "---" _NL

YAML_BLOCK: /(?:(?!^---\s*$)(?:.*\n))+/m

// Main class diagram
diagram: "classDiagram" _NL direction? statement*

// Optional direction specification
direction: "direction" DIRECTION _NL
DIRECTION: "BT" | "TB" | "LR" | "RL"

// Diagram statements
?statement: succ
          | moment_props
          | _NL

// Association/link: MOMENT1 --> MOMENT2 : label
succ: IDENTIFIER "-->" IDENTIFIER (":" label)? _NL?

label: /[^\n]+/

// Moment proposition declaration: MOMENT: prop, ~prop, ...
moment_props: IDENTIFIER ":" proposition ("," proposition)* _NL?
proposition: NOT? IDENTIFIER  // Propositions or their negations
// Named terminal (not a bare string literal) so it isn't filtered out of
// the parse tree -- Lark drops anonymous single-character string literals.
NOT: "~"

// Moment name identifier (alphanumeric + underscore/hyphen)
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_-]*/

// Newline (one or more)
_NL: /\r?\n/+

%import common.WS_INLINE
%ignore WS_INLINE
